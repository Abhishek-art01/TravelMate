# Shared runtime settings
NODE_ENV=development
APP_ENV=development
API_BASE_URL=http://localhost:8000
ADMIN_API_BASE_URL=http://localhost:8000

# FastAPI / backend
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=true
JWT_SECRET_KEY=replace-with-a-long-random-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travelmate
POSTGRES_USER=travelmate
POSTGRES_PASSWORD=travelmate
POSTGRES_SSLMODE=disable
MONGODB_URI=mongodb://travelmate:travelmate@localhost:27017/travelmate
REDIS_URL=redis://localhost:6379/0

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Android / iOS placeholders
ANDROID_PACKAGE=com.travelmate.app
IOS_BUNDLE_ID=com.travelmate.app

# Notifications / provider credentials
FIREBASE_PROJECT_ID=travelmate-dev
FIREBASE_CLIENT_EMAIL=service-account@travelmate-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Media / storage
R2_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=travelmate-media
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Payment gateway placeholders
PAYMENT_PROVIDER=placeholder
PAYMENT_API_KEY=replace-me
PAYMENT_SECRET=replace-me
PAYMENT_WEBHOOK_SECRET=replace-me

# Observability / alerts
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=travelmate-api
SENTRY_DSN=

# Compliance and legal review
DATA_RETENTION_DAYS=365
PRIVACY_CONTACT_EMAIL=privacy@travelmate.local
GRIEVANCE_CONTACT_EMAIL=support@travelmate.local
