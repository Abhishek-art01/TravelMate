# Shared runtime settings
NODE_ENV=development
APP_ENV=development
API_BASE_URL=http://localhost:8000
ADMIN_API_BASE_URL=http://localhost:8000

# FastAPI / backend host & networking
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# Database & cache connections (PostgreSQL, MongoDB, Redis)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travelmate
POSTGRES_USER=travelmate
POSTGRES_PASSWORD=travelmate
POSTGRES_SSLMODE=disable
DATABASE_URL=postgresql+asyncpg://travelmate:travelmate@localhost:5432/travelmate
MONGODB_URI=mongodb://travelmate:travelmate@localhost:27017/travelmate
REDIS_URL=redis://localhost:6379/0

# Supabase configuration & credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/jwks

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_AUTH_PROVIDERS=google

# Mobile application identifiers
ANDROID_PACKAGE=com.travelmate.app
IOS_BUNDLE_ID=com.travelmate.app

# Firebase notifications & service account credentials
FIREBASE_PROJECT_ID=travelmate-dev
FIREBASE_CLIENT_EMAIL=service-account@travelmate-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Profile media & storage configuration (Cloudflare R2 & Cloudinary)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
MEDIA_MAX_PROFILE_PHOTOS=6
MEDIA_MAX_PROFILE_PHOTO_SIZE_BYTES=10485760
MEDIA_SIGNED_URL_TTL_SECONDS=300
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Payment gateway placeholders & secrets
PAYMENT_PROVIDER=placeholder
PAYMENT_API_KEY=replace-me
PAYMENT_SECRET=replace-me
PAYMENT_WEBHOOK_SECRET=replace-me

# Observability & telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=travelmate-api
SENTRY_DSN=

# Compliance and legal review
DATA_RETENTION_DAYS=365
PRIVACY_CONTACT_EMAIL=privacy@travelmate.local
GRIEVANCE_CONTACT_EMAIL=support@travelmate.local
