# =============================================================================
# TravelMate — DEPLOYMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# This file is pre-filled with real values from your dev environment.
# Still required: REDIS_URL (Upstash), CORS origins, Sentry DSN, payment keys.
# Never commit this file with real secrets. Use platform secret managers.
# =============================================================================

# -----------------------------------------------------------------------------
# RUNTIME
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_ENVIRONMENT=production
APP_ENV=production

# -----------------------------------------------------------------------------
# API URLs — update after deploy to match your real hosted URLs
# -----------------------------------------------------------------------------
API_BASE_URL=https://travelmate-api.onrender.com
ADMIN_API_BASE_URL=https://travelmate-api.onrender.com
VITE_API_BASE_URL=https://travelmate-api.onrender.com/api/v1

# -----------------------------------------------------------------------------
# BACKEND NETWORKING
# -----------------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=false

# CORS — update with your real Vercel/custom domain URLs
CORS_ALLOWED_ORIGINS=https://travelmate.vercel.app,https://admin.travelmate.vercel.app

