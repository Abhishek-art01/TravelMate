# =============================================================================
# TravelMate — DEPLOYMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# This file is a TEMPLATE for production deployments.
# - Replace every <PLACEHOLDER> with real values on your server/platform.
# - Never commit real secrets. Use Render / Vercel / GitHub Actions secrets.
# - On Render: paste these as Environment Variables in the dashboard.
# - On Vercel: paste VITE_* vars in Project > Settings > Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# RUNTIME
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_ENVIRONMENT=production
APP_ENV=production

# -----------------------------------------------------------------------------
# API URLs — update these to your real deployed URLs
# -----------------------------------------------------------------------------
API_BASE_URL=https://travelmate-api.onrender.com
ADMIN_API_BASE_URL=https://travelmate-api.onrender.com
VITE_API_BASE_URL=https://travelmate-api.onrender.com/api/v1

# -----------------------------------------------------------------------------
# BACKEND NETWORKING
# -----------------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=false

# CORS — comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ALLOWED_ORIGINS=https://travelmate.vercel.app,https://admin.travelmate.vercel.app

# -----------------------------------------------------------------------------
# DATABASE — Supabase PostgreSQL (already production, no change needed)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres.bowtcpxzmqnqwqmmmpfw:<DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Individual fields (used by some services)
POSTGRES_HOST=aws-0-ap-southeast-1.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_DB=postgres
POSTGRES_USER=postgres.bowtcpxzmqnqwqmmmpfw
POSTGRES_PASSWORD=<DB_PASSWORD>
POSTGRES_SSLMODE=require

# -----------------------------------------------------------------------------
# REDIS — use Upstash for production (free serverless Redis)
# Get your URL from: https://console.upstash.com
# -----------------------------------------------------------------------------
REDIS_URL=rediss://<UPSTASH_USERNAME>:<UPSTASH_PASSWORD>@<UPSTASH_HOST>:6379

# -----------------------------------------------------------------------------
# SUPABASE — Auth & JWT
# -----------------------------------------------------------------------------
SUPABASE_URL=https://bowtcpxzmqnqwqmmmpfw.supabase.co
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_JWT_ISSUER=https://bowtcpxzmqnqwqmmmpfw.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://bowtcpxzmqnqwqmmmpfw.supabase.co/auth/v1/.well-known/jwks.json

# -----------------------------------------------------------------------------
# FRONTEND (Vite) — only VITE_* vars are exposed to the browser
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://bowtcpxzmqnqwqmmmpfw.supabase.co
VITE_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
VITE_AUTH_PROVIDERS=google

# -----------------------------------------------------------------------------
# CLOUDFLARE R2 — media & verification storage (already production)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=9cb671b6d224dabc6616497b819246e5
R2_BUCKET=travelmate-media
VERIFICATION_R2_BUCKET=travelmate-verification
R2_ENDPOINT=https://9cb671b6d224dabc6616497b819246e5.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
MEDIA_MAX_PROFILE_PHOTOS=6
MEDIA_MAX_PROFILE_PHOTO_SIZE_BYTES=10485760
MEDIA_SIGNED_URL_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# CLOUDINARY (alternative media storage — optional)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=mk5tgg3n
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

# -----------------------------------------------------------------------------
# FIREBASE — push notifications
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=travelmate-611f1
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@travelmate-611f1.iam.gserviceaccount.com
# Store the private key as a single-line string with \n literals
FIREBASE_PRIVATE_KEY=<FIREBASE_PRIVATE_KEY>

# -----------------------------------------------------------------------------
# IDENTITY VERIFICATION
# Change VERIFICATION_PROVIDER to your real provider (e.g. digio, hyperverge)
# before going live
# -----------------------------------------------------------------------------
VERIFICATION_PROVIDER=mock
VERIFICATION_PROVIDER_REGION=ap-south-1
VERIFICATION_WEBHOOK_SECRET=<GENERATE_A_STRONG_RANDOM_SECRET>

# -----------------------------------------------------------------------------
# PAYMENTS — replace with real gateway (e.g. Razorpay, Stripe)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=razorpay
PAYMENT_API_KEY=<PAYMENT_API_KEY>
PAYMENT_SECRET=<PAYMENT_SECRET>
PAYMENT_WEBHOOK_SECRET=<GENERATE_A_STRONG_RANDOM_SECRET>

# -----------------------------------------------------------------------------
# OBSERVABILITY — Sentry error tracking + OpenTelemetry
# -----------------------------------------------------------------------------
OTEL_SERVICE_NAME=travelmate-api
OTEL_EXPORTER_OTLP_ENDPOINT=https://<YOUR_OTEL_COLLECTOR_ENDPOINT>
SENTRY_DSN=<YOUR_SENTRY_DSN>

# -----------------------------------------------------------------------------
# COMPLIANCE
# -----------------------------------------------------------------------------
DATA_RETENTION_DAYS=365
PRIVACY_CONTACT_EMAIL=privacy@travelmate.app
GRIEVANCE_CONTACT_EMAIL=support@travelmate.app

# -----------------------------------------------------------------------------
# MOBILE APP IDENTIFIERS
# -----------------------------------------------------------------------------
ANDROID_PACKAGE=com.travelmate.app
IOS_BUNDLE_ID=com.travelmate.app

# =============================================================================
# REMOVED FROM DEPLOYMENT:
#   - MONGODB_* (not used in production stack — Supabase PostgreSQL is primary)
#   - NODE_ENV=development / APP_ENV=development (replaced with production)
#   - FASTAPI_DEBUG=true (disabled in production)
#   - localhost URLs (replaced with real deployed URLs)
# =============================================================================
